# Server
PORT=3000
DB_PATH=./data/wol.db

# Auth
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Initial admin credentials — used ONLY on first startup to seed the DB.
# After the first run these values are ignored; credentials live in the database.
# Change the password via the UI or directly in the DB after deployment.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=change-me-strong-password

# Rathole Tunnel (VPS <-> OpenWrt Modem)
# RATHOLE_PORT: Port that the OpenWrt Rathole client connects to on this VPS
# RATHOLE_TOKEN: Shared authentication secret between VPS Rathole server and OpenWrt client
RATHOLE_PORT=2333
RATHOLE_TOKEN=change-me-to-a-secure-random-token

# OpenWrt Agent HTTP Secret (BusyBox CGI auth)
AGENT_URL=http://127.0.0.1:9090
AGENT_TOKEN=change-me-agent-secret

